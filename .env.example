# Copy to .env (git-ignored) and fill in. Used by scripts/deploy.sh.
PI_HOST=
PI_USER=pi
PI_PORT=22
# Private key used to log in to the Pi.
PI_SSH_KEY_PATH=~/.ssh/id_ed25519
# Where the code lives on the Pi (default: /home/$PI_USER/pi-con).
#PI_TARGET_DIR=

# Home Assistant (scripts/ha_setup.py creates the admin and writes HA_TOKEN).
HA_ADMIN_USER=jarvis
HA_ADMIN_PASSWORD=
#HA_TOKEN=
CAMERA_RABBIT_RTSP=rtsp://user:password@192.168.x.x:554/stream2
