# Copy to .env (git-ignored) and fill in. Used by scripts/deploy.sh.
# In GitHub Actions the same names come from repository secrets instead.
PI_HOST=
PI_USER=pi
PI_PORT=22
# Private key used to log in to the Pi (local runs only; CI writes it from a secret).
PI_SSH_KEY_PATH=~/.ssh/id_ed25519
PI_TARGET_DIR=/opt/pi-con
#  Pi 4/5 with a 64-bit OS.
PI_PLATFORM=linux/arm64
