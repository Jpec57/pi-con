{
  "wakeword": "hey_jarvis",
  "wake_phrase": "Hey Jarvis",
  "threshold": 0.5,
  "audio_device": null,
  "cooldown_seconds": 2.0,
  "command": [
    "/usr/bin/logger",
    "pi-con wake word detected"
  ],
  "ui_port": 8080,
  "home_assistant_url": "http://127.0.0.1:8123",
  "cameras": [
    {
      "name": "rabbit",
      "entity": "camera.rabbit"
    }
  ],
  "skills_file": "config/skills.json",
  "skill_threshold": 0.8,
  "needle_enabled": true,
  "followup_seconds": 10,
  "mcp_port": 8765,
  "tts": {
    "enabled": false,
    "voice": "fr_FR-siwis-medium",
    "voice_dir": "models/tts-fr",
    "output_device": "pulse"
  },
  "ai": {
    "default_provider": "openai",
    "history_turns": 6,
    "max_output_tokens": 1024,
    "cloud_stt": true,
    "providers": {
      "anthropic": {
        "model": "claude-sonnet-5-5"
      },
      "openai": {
        "model": "gpt-6-luna",
        "stt_model": "gpt-4o-transcribe"
      }
    }
  }
}
